# .understandignore — patterns for files/dirs to exclude from analysis
# Syntax: same as .gitignore (globs, # comments, ! negation, trailing / for dirs)
# Lines below are suggestions — uncomment to activate.
# Use ! prefix to force-include something excluded by defaults.
#
# Built-in defaults (always excluded unless negated):
#   node_modules/, .git/, dist/, build/, obj/, *.lock, *.min.js, etc.
#

# --- Active project-specific exclusions ---

# Legacy archive; the maintained implementation lives under root source/.
old/

# OpenSpec proposals and archived change artifacts are outside the runtime graph.
/openspec/

# Generated and local build outputs.
_build*/
cmake-build-*/
sdk_*/_build*/

# Vendor Maxon SDK framework sources are dependencies, not plugin implementation.
sdk_*/frameworks/

# SDK projects mirror the maintained root source/ and res/ trees.
sdk_*/plugins/mmdtool/source/
sdk_*/plugins/mmdtool/res/
sdk_*/plugins/mmdtool/generated/

# Do not analyze the generated knowledge-graph workspace itself.
.ua/

# Keep the canonical root trees in scope explicitly.
!/source/
!/res/
!/cmake/
!/docs/

